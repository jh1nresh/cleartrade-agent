# ClearTrade Agent — environment template. Copy to .env.local. NEVER commit real values.

# --- CMC data (Track 2 needs this; read-only) ---
CMC_API_KEY=

# --- Mode gate. paper = no network signing. Live mode is intentionally NOT here. ---
CLEARTRADE_MODE=paper

# --- Risk config override path (optional; defaults to src/risk/config.ts) ---
# CLEARTRADE_RISK_CONFIG=./risk.local.json

# --- BNB AI Agent SDK dry-run metadata ---
# Track 2 uses a local BNBAgent SDK adapter only. Do not add wallet secrets here.
BNBAGENT_NETWORK=bsc-testnet
ERC8183_AGENT_URL=local-only://cleartrade-agent/erc8183

# --- Live trading (Track 1, Jun 22+ ONLY, after explicit go/no-go) ---
# Do NOT populate these during Track 2 build. A dedicated hackathon wallet only.
# BSC_RPC_URL=
# CLEARTRADE_WALLET_ADDRESS=
# (private key is loaded via Trust Wallet Agent Kit signer, never from a raw env var)
